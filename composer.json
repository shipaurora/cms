{
    "name": "shipaurora/cms",
    "description": "Aurora: a content management system for Laravel, built on Filament.",
    "keywords": [
        "aurora",
        "aurora-cms",
        "cms",
        "content-management",
        "laravel",
        "filament",
        "page-builder",
        "visual-editor",
        "headless",
        "mcp",
        "ai"
    ],
    "homepage": "https://shipaurora.com",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Thomas Alrek",
            "email": "thomas@alrek.no"
        }
    ],
    "support": {
        "issues": "https://github.com/shipaurora/cms/issues",
        "source": "https://github.com/shipaurora/cms",
        "docs": "https://shipaurora.com/docs"
    },
    "require": {
        "php": "^8.4",
        "althinect/filament-spatie-roles-permissions": "^4.0",
        "shipaurora/borealis": "^1.0.9",
        "blade-ui-kit/blade-heroicons": "^2.7",
        "blade-ui-kit/blade-icons": "^1.10",
        "carljanzell/filament-page-builder": "^0.4.2",
        "codeat3/blade-phosphor-icons": "^2.4",
        "datlechin/filament-menu-builder": "^1.1",
        "eslam-reda-div/filament-copilot": "^1.8",
        "filament/filament": "^5.10",
        "filament/spatie-laravel-media-library-plugin": "^5.10",
        "james-heinrich/getid3": "^1.9.27",
        "lara-zeus/spatie-translatable": "^2.0",
        "laravel/ai": "^0.11",
        "laravel/framework": "^13.17",
        "laravel/mcp": "^1.0",
        "laravel/passport": "^13.10",
        "laravel/scout": "^11.9",
        "livewire/livewire": "^4.4",
        "marcelweidum/filament-passkeys": "^3.0",
        "pragmarx/google2fa-qrcode": "^4.0",
        "spatie/image": "^3.9",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-passkeys": "^1.8",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-sluggable": "^4.0",
        "spatie/laravel-translatable": "^6.14",
        "spatie/laravel-translation-loader": "^2.8",
        "stechstudio/filament-impersonate": "^5.6",
        "usamamuneerchaudhary/filament-command-palette": "^2.0",
        "wallacemartinss/filament-icon-picker": "^2.0",
        "webonyx/graphql-php": "^15.38"
    },
    "require-dev": {
        "brianium/paratest": "^7.20",
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.3",
        "phpunit/phpunit": "^12.5.12"
    },
    "conflict": {
        "shipaurora/minimal": "<1.0.9"
    },
    "autoload": {
        "psr-4": {
            "Aurora\\": "src/",
            "Aurora\\Database\\Factories\\": "database/factories/",
            "Aurora\\Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Aurora\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aurora\\Providers\\AuroraServiceProvider",
                "Aurora\\Providers\\AdminPanelProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "test": "@php vendor/bin/paratest --processes=6"
    }
}
