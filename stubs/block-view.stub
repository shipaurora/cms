@props(['data' => []])

{{-- The same view draws the block on the website, in the visual editor and in previews. --}}
<div class="@container">
    <h2 class="text-2xl font-semibold" @editable('title')>{{ inline_text($data['title'] ?? '') }}</h2>

    @if (shows_field('text', $data['text'] ?? null))
        <p class="mt-3 whitespace-pre-line" @editable('text')>{{ plain_text($data['text'] ?? '') }}</p>
    @endif
</div>
